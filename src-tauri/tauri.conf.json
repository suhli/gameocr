{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GameOCR",
  "version": "0.1.0",
  "identifier": "io.gameocr.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{"label":"main","title":"GameOCR","width":1440,"height":920,"minWidth":1100,"minHeight":700,"backgroundColor":"#0d1117"}],
    "security": {"csp":"default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; script-src 'self'"}
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png"],
    "resources": {"resources/workers/llamacpp/cpu/": "workers/llamacpp/cpu/", "resources/workers/onnx/cpu/": "workers/onnx/cpu/", "resources/workers/onnx/bootstrap/": "workers/onnx/cuda/", "gpu-downloads.json": "gpu-downloads.json", "resources/runtime/": "./", "resources/licenses/": "licenses/"},
    "windows": {
      "webviewInstallMode": {"type":"downloadBootstrapper"},
      "nsis": {"template":"installer/nsis.nsi","installMode":"currentUser","languages":["SimpChinese","English"],"displayLanguageSelector":true},
      "wix": {"template":"installer/main.wxs","language":"zh-CN"}
    }
  }
}
